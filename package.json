{
  "name": "linkwork",
  "version": "1.0.0",
  "description": "WBS + Meeting Schedule Management App",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "build:mac": "electron-vite build && electron-builder --mac",
    "deploy": "electron-vite build && electron-builder --dir && rsync -a --delete dist/mac-arm64/LinkWork.app/ /Applications/LinkWork.app/ && echo '✅ LinkWork updated in /Applications'",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.170",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "better-sqlite3": "^11.7.0",
    "date-fns": "^4.1.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "optionalDependencies": {
    "@fugood/whisper.node": "^1.0.22",
    "sherpa-onnx-node": "^1.13.3",
    "silero-vad-node": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.1"
  },
  "build": {
    "appId": "com.linkwork.app",
    "productName": "LinkWork",
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "**/*.node",
      "node_modules/sherpa-onnx-darwin-arm64/**"
    ],
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "회의 녹음을 위해 마이크 접근이 필요합니다.",
        "NSAudioCaptureUsageDescription": "회의 상대방 음성 녹음을 위해 시스템 오디오 접근이 필요합니다."
      }
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ]
  }
}
